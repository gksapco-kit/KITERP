# ============================================
# KITERP Backend - Environment Variables
# ============================================
# Copy to .env:  cp .env.example .env
# For Docker: these are overridden by docker-compose environment
# ============================================

# Application
APP_NAME="KIT ERP API"
DEBUG=true
BASE_DOMAIN=kiterp.com

# New vendors: true = approved immediately (same as admin approve). false = stay Pending until super-admin approves.
AUTO_APPROVE_NEW_VENDORS=true

# Database (local dev: localhost, docker: postgres)
# If Docker maps Postgres to host port 5433 (see project root .env POSTGRES_HOST_PORT), use :5433 here.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/kiterp

# Redis (local dev: localhost, docker: redis)
REDIS_URL=redis://localhost:6379

# JWT - CHANGE IN PRODUCTION!
JWT_SECRET_KEY=your-super-secret-jwt-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=365

# AWS S3 — when ACCESS_KEY + SECRET + BUCKET are set, FileService uploads to S3.
# Leave blank for local dev (files saved under backend/uploads/ and served at /uploads/).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_S3_BUCKET=kiterp-uploads
AWS_CLOUDFRONT_URL=

# Email / SMTP (optional — leave SMTP_HOST blank for dev mode)
# In dev mode, verification codes are logged to the backend container output AND
# returned in the API response as `dev_hint` so the UI can auto-fill them.
# Examples:
#   Mailtrap (testing)        SMTP_HOST=sandbox.smtp.mailtrap.io  SMTP_PORT=2525
#   SendGrid                  SMTP_HOST=smtp.sendgrid.net          SMTP_PORT=587  SMTP_USER=apikey  SMTP_PASSWORD=<api-key>
#   Amazon SES (ap-south-1)   SMTP_HOST=email-smtp.ap-south-1.amazonaws.com  SMTP_PORT=587
#   Gmail (app password)      SMTP_HOST=smtp.gmail.com             SMTP_PORT=587
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
FROM_EMAIL=noreply@kiterp.com
# Preferred for OTP email (works in Docker). Create at SendGrid → Settings → API Keys.
SENDGRID_API_KEY=
# Twilio Verify uses this dynamic template — run: python scripts/fix_sendgrid_otp_subject.py
SENDGRID_OTP_TEMPLATE_ID=d-14f75148da1a4b7d8a1a5f8cf9f388a5

# Vendor dashboard (/auth/login) on generic host (e.g. localhost): scope login to one business
# when the same email exists on multiple User rows. Production: subdomain sets tenant automatically.
# Pair with vendor-web VITE_VENDOR_LOGIN_SLUG or http://localhost:3001/login?vendor=<slug>
# VENDOR_LOGIN_DEFAULT_SLUG=my-business

# Razorpay (business front online payments — leave blank to use COD only in production;
# in DEBUG mode a dev mock gateway is available without real keys)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook secret from Razorpay Dashboard → Webhooks (for payment.captured idempotency)
RAZORPAY_WEBHOOK_SECRET=

# Twilio OTP — use LIVE credentials from the Console dashboard (not Test Credentials tab).
# Create a Verify service (Verify → Services) → TWILIO_VERIFY_SERVICE_SID (VA...).
# SMS: set TWILIO_FROM_NUMBER (E.164).
# Twilio Verify email is fallback only; set SendGrid template subject in Twilio Console if used.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
TWILIO_FROM_NUMBER=

# ============================================
# CRM
# ============================================
# Symmetric key (Fernet, base64-urlsafe 32 bytes) used to encrypt PII at rest.
# Generate with:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# If left blank in DEBUG mode an ephemeral key is generated (data won't survive restart).
CRM_ENCRYPTION_KEY=

# Celery broker / result backend (separate Redis DB indexes from app cache)
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# OpenAI key for AI features (lead scoring, summaries, next-best-action, bot replies).
# Per-vendor keys configured via /vendors/me/crm/integrations override this.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional default global integration credentials (per-vendor overrides take priority).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Twilio WhatsApp sender (E.164). Sandbox: +14155238886 after enabling WhatsApp in Twilio Console.
TWILIO_WHATSAPP_FROM=
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
