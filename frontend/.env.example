# Production / `vite preview` only. `npm run dev` always uses /api/v1 + the Vite proxy (vite.config.ts);
# do not set VITE_API_URL for local dev — calling :8000 from the browser can fail in some environments.
# VITE_API_URL=https://your-api.example.com/api/v1
VITE_BASE_DOMAIN=kiterp.com

# Vendor/business dashboard (vendor-web). Used by Business Account detail → “Open vendor app”.
# VITE_VENDOR_URL=http://localhost:3001

# Customer storefront origin (storefront-web). Required in production builds so Preview opens
# `{VITE_STOREFRONT_URL}/store/{slug}/preview/{token}` instead of unresolvable `{slug}.kiterp.com`.
# Local `npm run dev`: omit this (defaults to same host :3002).
# VITE_STOREFRONT_URL=http://localhost:3002
