# ============================================
# KITERP - Environment Variables
# ============================================
# Copy this file to .env and update values:
#   cp .env.example .env
#
# REQUIRED variables are marked -- the app will refuse to start without them.
# ============================================

# ---- PostgreSQL (RDS or self-hosted) ----
# Full async connection string. Examples:
#   RDS:         postgresql+asyncpg://postgres:PASSWORD@kiterp-db.xxxxx.ap-south-1.rds.amazonaws.com:5432/kiterp
#   Local/Docker: postgresql+asyncpg://postgres:postgres@localhost:5432/kiterp
DATABASE_URL=postgresql+asyncpg://postgres:YOUR_PASSWORD@YOUR_RDS_ENDPOINT:5432/kiterp

# ---- Redis (ElastiCache or self-hosted) ----
# Full connection string. Examples:
#   ElastiCache: redis://:PASSWORD@kiterp-redis.xxxxx.cache.amazonaws.com:6379
#   Local/Docker: redis://localhost:6379
REDIS_URL=redis://:YOUR_PASSWORD@YOUR_ELASTICACHE_ENDPOINT:6379

# ---- JWT (REQUIRED) ----
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=your-super-secret-jwt-key-minimum-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- Domain ----
BASE_DOMAIN=kiterp.com

# ---- API URLs (for production, use relative paths) ----
VITE_ADMIN_API_URL=/api/v1
VITE_VENDOR_API_URL=/api/v1
VITE_STOREFRONT_API_URL=/api/v1

# ---- AWS S3 (for image uploads) ----
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_S3_BUCKET=kiterp-uploads
AWS_CLOUDFRONT_URL=

# ---- Email / SMTP (optional) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
FROM_EMAIL=noreply@kiterp.com

# ---- CRM ----
# Symmetric key (Fernet, base64-urlsafe 32 bytes) used to encrypt PII at rest.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CRM_ENCRYPTION_KEY=

# Celery broker/result backend (use separate Redis DB indexes from app cache)
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# OpenAI key for AI features (lead scoring, summaries, next-best-action, bot replies)
OPENAI_API_KEY=

# Optional default global integration credentials (per-vendor overrides take priority)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
SENDGRID_API_KEY=
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
