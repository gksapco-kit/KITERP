# Vendor Web - Environment Variables
VITE_API_URL=http://localhost:8000/api/v1
# Same email on multiple businesses: set to your vendor slug (must match backend VENDOR_LOGIN_DEFAULT_SLUG), or use /login?vendor=your-slug
# VITE_VENDOR_LOGIN_SLUG=my-business
# Storefront URL for preview links in the storefront builder.
# Local dev: http://localhost:3002 | Production: leave blank (uses slug.kiterp.com)
# VITE_STOREFRONT_URL=http://localhost:3002

# Optional — Help menu (header) & Settings → About
# E.164-style number for one-tap Call (e.g. +918000123456)
# VITE_SUPPORT_PHONE=+918000123456
# Chat link: WhatsApp, Intercom, or any https URL (defaults to mailto support)
# VITE_SUPPORT_CHAT_URL=https://wa.me/918000123456
