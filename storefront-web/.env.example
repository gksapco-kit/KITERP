# Storefront Web — Environment Variables
#
# Dev server: npm run dev  →  http://localhost:3002  (see vite.config.ts)
# Leave VITE_API_URL unset to use same-origin /api/v1 (Vite proxies to the backend — avoids CORS).
# VITE_API_URL=http://localhost:8000/api/v1
#
# Slug used on http://localhost:3002/local/employee-hr (match setup_vendor.py or your vendor slug)
# VITE_DEV_VENDOR_SLUG=test
