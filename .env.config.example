# ============================================
# KITERP Production Config (EC2 / AWS)
# ============================================
# This file IS committed. Copy on the server (secrets stay on the server only):
#   cp .env.config.example .env.config
#   nano .env.config
#
# Deploy:
#   ./scripts/deploy.sh
# Or manually:
#   docker compose --env-file .env.config -f docker-compose.prod.yml up -d --build
#
# REQUIRED for vendor signup email OTP (not in git — copy from backend/.env on your dev PC):
#   SENDGRID_API_KEY=SG.xxx   (or SMTP_PASSWORD=SG.xxx with SMTP_HOST=smtp.sendgrid.net)
# ============================================

# ---- Public Host / URLs ----
PUBLIC_IP=YOUR_EC2_PUBLIC_IP
BASE_DOMAIN=kiterp.com

VITE_ADMIN_URL=http://YOUR_EC2_PUBLIC_IP/admin
VITE_VENDOR_URL=http://YOUR_EC2_PUBLIC_IP/vendor
VITE_STOREFRONT_URL=http://YOUR_EC2_PUBLIC_IP

VITE_ADMIN_BASE_PATH=/admin/
VITE_VENDOR_BASE_PATH=/vendor/
VITE_STOREFRONT_BASE_PATH=/
VITE_ADMIN_ROUTER_BASENAME=/admin
VITE_VENDOR_ROUTER_BASENAME=/vendor

VITE_ADMIN_API_URL=/api/v1
VITE_VENDOR_API_URL=/api/v1
VITE_STOREFRONT_API_URL=/api/v1

# ---- PostgreSQL / Redis ----
DATABASE_URL=postgresql+asyncpg://postgres:PASSWORD@YOUR_RDS_ENDPOINT:5432/kiterp
REDIS_URL=redis://YOUR_ELASTICACHE_ENDPOINT:6379

# ---- App ----
AUTO_APPROVE_NEW_VENDORS=true

# ---- Security ----
# openssl rand -hex 32
JWT_SECRET_KEY=CHANGE_ME_64_HEX_CHARS
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CRM_ENCRYPTION_KEY=

ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=365

# ---- AWS S3 ----
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_S3_BUCKET=kiterp-uploads
AWS_CLOUDFRONT_URL=

# ---- Email / OTP (SendGrid HTTP API — SMTP optional) ----
# Minimal prod setup (SMTP can stay empty/commented):
#   SENDGRID_API_KEY=SG.xxx
#   SENDGRID_FROM_EMAIL=noreply@your-verified-domain.com
#   FROM_EMAIL=noreply@your-verified-domain.com   # keep the SAME verified address
# FROM must be verified in SendGrid → Settings → Sender Authentication.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
SENDGRID_OTP_TEMPLATE_ID=d-14f75148da1a4b7d8a1a5f8cf9f388a5
FROM_EMAIL=noreply@kiterp.com

# ---- Twilio (SMS OTP + CRM messaging) ----
# from_number = SMS-capable Twilio phone (e.g. +14704999996)
# whatsapp_from = WhatsApp sender ONLY — sandbox: +14155238886 (NOT the same as from_number)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
TWILIO_FROM_NUMBER=
TWILIO_WHATSAPP_FROM=

# ---- Optional AI ----
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ---- Razorpay (optional) ----
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

SKIP_MIGRATIONS=false
