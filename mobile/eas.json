{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "base": {
      "distribution": "store",
      "channel": "production"
    },
    "development": {
      "extends": "base",
      "distribution": "internal",
      "developmentClient": true,
      "channel": "development",
      "ios": {
        "simulator": true
      }
    },
    "preview": {
      "extends": "base",
      "distribution": "internal",
      "channel": "preview"
    },
    "production": {
      "extends": "base",
      "autoIncrement": true
    },
    "vendor-android": {
      "extends": "production",
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "VENDOR_SLUG": "rainbow-nursery",
        "EXPO_PUBLIC_API_URL": "https://kiterp.com/api/v1",
        "EXPO_PUBLIC_STOREFRONT_URL": "https://kiterp.com"
      }
    },
    "vendor-android-sr": {
      "extends": "production",
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "VENDOR_SLUG": "sr-marketing-and-services",
        "EXPO_PUBLIC_API_URL": "https://kiterp.com/api/v1",
        "EXPO_PUBLIC_STOREFRONT_URL": "https://kiterp.com"
      }
    },
    "vendor-ios": {
      "extends": "production",
      "ios": {
        "enterpriseProvisioning": "universal"
      },
      "env": {
        "VENDOR_SLUG": "rainbow-nursery",
        "EXPO_PUBLIC_API_URL": "https://kiterp.com/api/v1",
        "EXPO_PUBLIC_STOREFRONT_URL": "https://kiterp.com"
      }
    },
    "vendor-ios-sr": {
      "extends": "production",
      "ios": {
        "enterpriseProvisioning": "universal"
      },
      "env": {
        "VENDOR_SLUG": "sr-marketing-and-services",
        "EXPO_PUBLIC_API_URL": "https://kiterp.com/api/v1",
        "EXPO_PUBLIC_STOREFRONT_URL": "https://kiterp.com"
      }
    },
    "vendor-all": {
      "extends": "production",
      "env": {
        "VENDOR_SLUG": "rainbow-nursery",
        "EXPO_PUBLIC_API_URL": "https://kiterp.com/api/v1",
        "EXPO_PUBLIC_STOREFRONT_URL": "https://kiterp.com"
      }
    },
    "vendor-all-sr": {
      "extends": "production",
      "env": {
        "VENDOR_SLUG": "sr-marketing-and-services",
        "EXPO_PUBLIC_API_URL": "https://kiterp.com/api/v1",
        "EXPO_PUBLIC_STOREFRONT_URL": "https://kiterp.com"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "serviceAccountKeyPath": "./google-services.json",
        "track": "internal"
      },
      "ios": {
        "appleId": "${APPLE_ID}",
        "ascAppId": "${ASC_APP_ID}",
        "appleTeamId": "${APPLE_TEAM_ID}"
      }
    }
  }
}
