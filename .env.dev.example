# ============================================
# KITERP - Dev Environment (AWS Free Tier)
# ============================================
# Copy to .env:  cp .env.dev.example .env
# All databases run in Docker on the same EC2 instance.
# ============================================

# ---- PostgreSQL (runs in Docker) ----
POSTGRES_PASSWORD=postgres

# ---- JWT ----
JWT_SECRET_KEY=dev-only-secret-key-do-not-use-in-production

# ---- Domain ----
# Use the EC2 public IP or a test domain
BASE_DOMAIN=localhost

# ---- API URL (relative, proxied by Nginx) ----
VITE_API_URL=/api/v1

# ---- AWS S3 (optional for dev -- falls back to local uploads/) ----
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_S3_BUCKET=kiterp-uploads-dev
