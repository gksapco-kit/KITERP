# ============================================
# KITERP - Production gateway (HTTP + HTTPS)
# ============================================
# Requires Let's Encrypt certs on the EC2 host:
#   /etc/letsencrypt/live/kiterp.com/fullchain.pem
#   /etc/letsencrypt/live/kiterp.com/privkey.pem
#
# Enable: cp docker/nginx/conf.d/default.conf.https docker/nginx/conf.d/default.conf
# ============================================

# HTTP — health check, ACME, redirect everything else to HTTPS
server {
    listen 80 default_server;
    server_name _;

    location /health {
        access_log off;
        proxy_pass http://backend_api/health;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location /api/ {
        proxy_pass http://backend_api;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# HTTPS — app routes
server {
    listen 443 ssl;
    server_name kiterp.com www.kiterp.com;

    ssl_certificate /etc/letsencrypt/live/kiterp.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/kiterp.com/privkey.pem;

    location /health {
        access_log off;
        proxy_pass http://backend_api/health;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /api/ {
        proxy_pass http://backend_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }

    location /uploads/ {
        proxy_pass http://backend_api;
        proxy_set_header Host $host;
    }

    location = /admin {
        return 301 /admin/;
    }

    location /admin/ {
        proxy_pass http://admin_frontend/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_redirect off;
    }

    location = /vendor {
        return 301 /vendor/;
    }

    location = /vendor/signup {
        return 301 /create-business;
    }

    location = /vendor/verify-email {
        return 301 /create-business/verify-email;
    }

    location /vendor/ {
        proxy_pass http://vendor_frontend/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_redirect off;
    }

    location / {
        proxy_pass http://storefront_frontend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
