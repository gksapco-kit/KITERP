
server {
    listen 80;
    server_name kiterp.com www.kiterp.com;

    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name kiterp.com www.kiterp.com;

    ssl_certificate /etc/letsencrypt/live/kiterp.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/kiterp.com/privkey.pem;

    location /health {
        access_log off;
        return 200 'ok';
        add_header Content-Type text/plain;
    }

    location / {
        proxy_pass http://kiterp-admin:3000;
	proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /api/ {
        proxy_pass http://kiterp-backend:8000/;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
